{
  "manifest_version": 3,
  "name": "X Account Tools",
  "version": "2.1.0",
  "description": "Bot detection, location flags, and tools for X/Twitter",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Account Tools"
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://x-bot-detector-production.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "countryFlags.js",
        "botDetection.js",
        "botLegitimacy.js",
        "botCache.js",
        "botUI.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageScript.js"],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}

